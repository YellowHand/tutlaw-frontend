# Build produkcyjny (npm run build, deploy/deploy-frontend.sh): adres backendu na AWS.
# Tylko adresy, żadnych sekretów: zmienne VITE_ trafiają do przeglądarki i są jawne.
# Zmiana adresu wymaga ponownego buildu (wartość wpisuje się w kod w chwili budowania).
VITE_API_BASE_URL=https://api.gradusiuris.pl

# Sentry (raportowanie błędów, serwer w UE). Wklej DSN projektu „gradusiuris-frontend” z Sentry (Settings > Client Keys).
# DSN nie jest sekretem (trafia do przeglądarki). Puste = Sentry wyłączony. Token do map źródeł NIE należy tutaj:
# wpisz go do .env.production.local (poza gitem), zob. instrukcja Sentry.
VITE_SENTRY_DSN=
