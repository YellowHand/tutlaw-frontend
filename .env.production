# Adres backendu w buildzie produkcyjnym (npm run build). WPISZ PRAWDZIWY ADRES przed wdrożeniem, np. https://api.twojadomena.pl
# Pusta wartość (VITE_API_BASE_URL=) oznacza ten sam adres co strona, o ile serwer przekazuje /api do backendu.
# Lokalnie (npm run dev) obowiązuje .env.
VITE_API_BASE_URL=https://WPISZ-ADRES-BACKENDU.example
