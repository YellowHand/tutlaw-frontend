# Wzór. Pliki .env.development (lokalnie) i .env.production (build na serwer) są już w repozytorium.
# Własne nadpisania na swoim komputerze: .env.local albo .env.development.local (są w .gitignore przez wzorzec *.local).
VITE_API_BASE_URL=http://localhost:8080
# Sentry (opcjonalnie, tylko build produkcyjny): VITE_SENTRY_DSN w .env.production. Lokalnie zostaw puste: nic nie jest wysyłane.
# Mapy źródeł: SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT w .env.production.local (poza gitem).
