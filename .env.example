# Wzór. Pliki .env.development (lokalnie) i .env.production (build na serwer) są już w repozytorium.
# Własne nadpisania na swoim komputerze: .env.local albo .env.development.local (są w .gitignore przez wzorzec *.local).
VITE_API_BASE_URL=http://localhost:8080
# Sentry (opcjonalnie, tylko build produkcyjny): VITE_SENTRY_DSN w .env.production. Lokalnie zostaw puste: nic nie jest wysyłane.
# Mapy źródeł: SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT w .env.production.local (poza gitem).
# Google Analytics 4 (opcjonalnie, tylko build produkcyjny): VITE_GA_MEASUREMENT_ID w .env.production. Lokalnie puste:
# bez identyfikatora nie ma analityki ani banera zgody.
# Cloudflare Turnstile (pole „nie jestem robotem” przy rejestracji i logowaniu, opcjonalnie): VITE_TURNSTILE_SITE_KEY w .env.production.
# Lokalnie puste: bez klucza nie ma pola i nic nie jest pobierane z Cloudflare. Do prób lokalnych Cloudflare daje klucz testowy
# 1x00000000000000000000AA (zawsze przechodzi), który działa z sekretem 1x0000000000000000000000000000000AA po stronie backendu.
